<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.cyuCBMclean</groupId>
    <artifactId>cyuclear</artifactId>
    <version>1.4.0</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.version>1.9.22</kotlin.version>
        <jedis.version>4.4.8</jedis.version>
        <mysql.version>9.6.0</mysql.version>
        <kotlin.jvmTarget>1.8</kotlin.jvmTarget>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <platform.name>paper</platform.name>
        <platform.source.name>paper</platform.source.name>
        <folia.supported>false</folia.supported>
        <spigot-api.version>1.13.2-R0.1-SNAPSHOT</spigot-api.version>
        <paper-api.version>1.21.8-R0.1-SNAPSHOT</paper-api.version>
    </properties>

    <repositories>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>${jedis.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>1.7.36</version>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <finalName>${project.artifactId}-${platform.name}-${project.version}</finalName>
        <outputDirectory>${project.build.directory}/classes-${platform.name}</outputDirectory>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/${platform.name}/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <excludes>
                        <exclude>**/*.kt</exclude>
                        <exclude>cyuclear-build.properties</exclude>
                        <exclude>bin-menu.yml</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/core/**</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/gui/**</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/hook/**</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/sync/**</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/service/BrainFilter*.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/util/ThreadUtils*.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/cluster/ItemStackCodec$RawCodec.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/config/BinEntryRules$ContainerAccessor.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/config/BinEntryRules$isNonEmptyContainer$1$accessor$1.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/menu/MenuHeadFactory$createGameProfileWriter$1.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/menu/MenuHeadFactory$createProfileWriter$1.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/menu/MenuHeadFactory$profileField$1.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/menu/MenuHeadFactory$TextureWriter.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/menu/MenuIconFactory$discoverModelDataWriter$1.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/menu/MenuIconFactory$discoverModelDataWriter$2.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/menu/MenuIconFactory$ModelDataWriter.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/menu/MenuIconFactory$UnsupportedModelDataWriter.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/platform/EntityStateBridge$isInRaid$method$1.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/util/ItemIdentity$CmdReader.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/util/ItemIdentity$DiscoveringCmdReader$resolve$1.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/util/ItemIdentity$DiscoveringCmdReader.class</exclude>
                        <exclude>org/cyuCBMclean/cyuclear/util/ItemIdentity$UnsupportedCmdReader.class</exclude>
                    </excludes>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <jvmTarget>${kotlin.jvmTarget}</jvmTarget>
                            <sourceDirs>
                                <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
                                <sourceDir>${project.basedir}/src/${platform.source.name}/kotlin</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                        <configuration>
                            <jvmTarget>${kotlin.jvmTarget}</jvmTarget>
                            <sourceDirs>
                                <sourceDir>${project.basedir}/src/test/kotlin</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>paper</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <platform.name>paper</platform.name>
                <platform.source.name>paper</platform.source.name>
                <folia.supported>false</folia.supported>
                <kotlin.jvmTarget>1.8</kotlin.jvmTarget>
                <maven.compiler.source>1.8</maven.compiler.source>
                <maven.compiler.target>1.8</maven.compiler.target>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.spigotmc</groupId>
                    <artifactId>spigot-api</artifactId>
                    <version>${spigot-api.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>folia</id>
            <properties>
                <platform.name>folia</platform.name>
                <platform.source.name>folia</platform.source.name>
                <folia.supported>true</folia.supported>
                <kotlin.jvmTarget>17</kotlin.jvmTarget>
                <maven.compiler.source>17</maven.compiler.source>
                <maven.compiler.target>17</maven.compiler.target>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.papermc.paper</groupId>
                    <artifactId>paper-api</artifactId>
                    <version>${paper-api.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>legacy</id>
            <properties>
                <platform.name>legacy</platform.name>
                <platform.source.name>legacy</platform.source.name>
                <folia.supported>false</folia.supported>
                <kotlin.jvmTarget>1.8</kotlin.jvmTarget>
                <maven.compiler.source>1.8</maven.compiler.source>
                <maven.compiler.target>1.8</maven.compiler.target>
                <spigot-api.version>1.8.8-R0.1-SNAPSHOT</spigot-api.version>
            </properties>
            <build>
                <finalName>${project.artifactId}-legacy-${project.version}</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.3</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <shadedArtifactAttached>false</shadedArtifactAttached>
                                    <finalName>${project.build.finalName}</finalName>
                                    <relocations>
                                        <relocation>
                                            <pattern>redis.clients.jedis</pattern>
                                            <shadedPattern>org.cyuCBMclean.cyuclear.internal.redis</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>org.apache.commons.pool2</pattern>
                                            <shadedPattern>org.cyuCBMclean.cyuclear.internal.pool</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>org.slf4j</pattern>
                                            <shadedPattern>org.cyuCBMclean.cyuclear.internal.slf4j</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>org.json</pattern>
                                            <shadedPattern>org.cyuCBMclean.cyuclear.internal.json</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>com.google.gson</pattern>
                                            <shadedPattern>org.cyuCBMclean.cyuclear.internal.gson</shadedPattern>
                                        </relocation>
                                    </relocations>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                    </transformers>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <exclude>META-INF/versions/9/module-info.class</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <dependency>
                    <groupId>org.spigotmc</groupId>
                    <artifactId>spigot-api</artifactId>
                    <version>${spigot-api.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>modern-api-check</id>
            <properties>
                <platform.name>paper</platform.name>
                <platform.source.name>paper</platform.source.name>
                <folia.supported>false</folia.supported>
                <spigot-api.version>1.20.1-R0.1-SNAPSHOT</spigot-api.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.spigotmc</groupId>
                    <artifactId>spigot-api</artifactId>
                    <version>${spigot-api.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
